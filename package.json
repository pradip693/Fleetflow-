{
  "name": "feetflow-frontend-boilerplate-3",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "node scripts/check-env.mjs && next dev",
    "build": "node scripts/check-env.mjs && next build",
    "start": "next start",
    "staging": "cross-env NODE_ENV=staging node scripts/check-env.mjs && next dev",
    "staging:build": "cross-env NODE_ENV=staging node scripts/check-env.mjs && next build",
    "staging:start": "cross-env NODE_ENV=staging node scripts/check-env.mjs && next start",
    "production": "cross-env NODE_ENV=production node scripts/check-env.mjs && next dev",
    "production:build": "cross-env NODE_ENV=production node scripts/check-env.mjs && next build",
    "production:start": "cross-env NODE_ENV=production node scripts/check-env.mjs && next start",
    "lint": "next lint",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "deploy:install": "pnpm install --frozen-lockfile",
    "deploy:build": "NODE_ENV=production pnpm build",
    "deploy": "pnpm deploy:install && pnpm deploy:build",
    "pm2:deploy": "pnpm deploy && pm2 start ecosystem.config.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.13.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "js-cookie": "^3.0.5",
    "knip": "^5.83.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.1",
    "react-image-crop": "^11.0.10",
    "react-resizable-panels": "^4.6.0",
    "recharts": "3.7.0",
    "shadcn": "^3.8.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.3.0",
    "knip": "^5.82.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "last 2 edge versions"
  ]
}
